# =====================================================
# MODE
# =====================================================

MODE=paper

# =====================================================
# BINANCE
# =====================================================

BINANCE_TESTNET=true

BINANCE_API_KEY=

BINANCE_SECRET_KEY=

# Deliberately separate from MODE/BINANCE_TESTNET above -- setting
# MODE=live and BINANCE_TESTNET=false is NOT enough by itself to
# place real orders on mainnet. This must also be explicitly set to
# true. Leave this false/unset for testnet, and for as long as you
# are not certain you want real funds at risk.
LIVE_TRADING_CONFIRMED=false

# =====================================================
# ACCOUNT
# =====================================================

ACCOUNT_BALANCE=100.0

# =====================================================
# RISK MANAGEMENT
# =====================================================

RISK_PER_TRADE_PERCENT=0.25

MAX_OPEN_POSITIONS=3

MAX_POSITION_EXPOSURE_PERCENT=5

MINIMUM_RISK_REWARD_RATIO=1.2

MAX_DAILY_LOSS_PERCENT=5

MAX_DAILY_TRADES=20

MAXIMUM_DAILY_DRAWDOWN_PERCENT=5.0

ENABLE_DAILY_TRADE_LIMIT=true

ENABLE_DAILY_LOSS_LIMIT=true

ENABLE_DRAWDOWN_PROTECTION=true

# =====================================================
# MARKET
# =====================================================

SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

KLINE_INTERVAL=1m

# =====================================================
# ATR / MULTIPLIERS
# =====================================================

ATR_PERIOD=14

ATR_STOP_MULTIPLIER=1.0

ATR_TAKE_PROFIT_MULTIPLIER=3.0

ATR_TRAILING_MULTIPLIER=2.0

ENABLE_ATR_TRAILING=false

MINIMUM_ATR_PERCENT=0.01

ATR_VALIDATION_PERIOD=14

MIN_STRUCTURE_CANDLES=6

# =====================================================
# SIGNAL QUALITY
# =====================================================

MINIMUM_SIGNAL_STRENGTH=0.50

MIN_SIGNAL_CONFIDENCE=0.45

ENABLE_VOLATILITY_FILTER=true

ENABLE_EMA_TREND_FILTER=true

EMA_FAST_PERIOD=9

EMA_SLOW_PERIOD=21

MIN_TREND_STRENGTH_PERCENT=0.15

ENABLE_MARKET_REGIME_ALIGNMENT=false

ENABLE_SIGNAL_COOLDOWN=true

SIGNAL_COOLDOWN_SECONDS=5

# =====================================================
# MARKET STRUCTURE
# =====================================================

STRUCTURE_MAX_PRICE_HISTORY=300

STRUCTURE_SWING_WINDOW=2

STRUCTURE_MIN_REQUIRED_SWINGS=2

STRUCTURE_MIN_SCORE=2.0

STRUCTURE_MIN_IMPULSE_WINDOW=5

STRUCTURE_MIN_IMPULSE_PERCENT=0.10

STRUCTURE_IMPULSE_SCORE=1.0

STRUCTURE_BULLISH_HIGH_SCORE=1.0

STRUCTURE_BULLISH_LOW_SCORE=1.0

STRUCTURE_ENABLE_CONSOLIDATION_FILTER=true

STRUCTURE_MIN_CONSOLIDATION_WINDOW=10

STRUCTURE_MAX_CONSOLIDATION_RANGE=0.30

STRUCTURE_ENABLE_FAKE_BREAKOUT_FILTER=false

STRUCTURE_MIN_BREAKOUT_DISTANCE_PERCENT=0.20

STRUCTURE_REQUIRE_BOS_CONFIRMATION=false

STRUCTURE_ENABLE_REGIME_AWARE=false

STRUCTURE_ENABLE_ADAPTIVE_THRESHOLDS=false

# =====================================================
# TRADE MANAGEMENT
# =====================================================

ENABLE_TRAILING_STOP=true

ENABLE_BREAKEVEN=true

BREAKEVEN_TRIGGER_PERCENT=0.50

ENABLE_PARTIAL_TAKE_PROFIT=false

PARTIAL_TAKE_PROFIT_PERCENT=50.0

ENABLE_DYNAMIC_TAKE_PROFIT=false

DYNAMIC_TAKE_PROFIT_PROXIMITY_PERCENT=90.0

ENABLE_VOLATILITY_BASED_MANAGEMENT=false

# =====================================================
# EXCHANGE PRECISION
# =====================================================

QUANTITY_PRECISION=6

# Casas decimais usadas para arredondar stop_loss/take_profit no
# RiskAgent. 2 casas quebra ativos abaixo de ~$1 (ex. DOGEUSDT) --
# a distância de stop baseada em ATR fica menor que o próprio degrau
# de arredondamento, fazendo todo sinal ser rejeitado como
# INVALID_RISK_LEVELS. 6 cobre tanto ativos caros quanto baratos.
PRICE_PRECISION=6

MIN_ORDER_QUANTITY=0.00001

MIN_ORDER_NOTIONAL=0.0

# =====================================================
# SIMULATION (paper only)
# =====================================================

ENABLE_FEE_SIMULATION=true

ENABLE_SLIPPAGE_SIMULATION=true

MAKER_FEE_PERCENT=0.001

TAKER_FEE_PERCENT=0.001

# =====================================================
# EXECUTION / FEATURE FLAGS
# =====================================================

ENABLE_PAPER_EXECUTION=true

ENABLE_OPTIMIZER=false

ENABLE_MARKET_REGIME=false

ENABLE_REPLAY=false

# =====================================================
# LOGGING
# =====================================================

LOG_LEVEL=INFO

# Max size (bytes) of each runtime/error log file before it rotates
# and gzip-compresses. Default: 10MB.
MAX_LOG_FILE_SIZE=10000000

# How many compacted (.gz) log files to keep per log type before the
# oldest is discarded. Default: 5.
LOG_BACKUP_COUNT=5

# =====================================================
# API
# =====================================================

API_HOST=127.0.0.1

API_PORT=8000

# slowapi rate-limit spec applied to sensitive endpoints
# (PUT /settings, POST /runner/start, POST /runner/stop).
API_RATE_LIMIT=10/minute

# =====================================================
# API SECURITY
# =====================================================

# Shared-secret token required in the X-API-Token header for
# sensitive endpoints (PUT /settings, POST /runner/start,
# POST /runner/stop). Leave empty to disable auth (fine for a purely
# local setup on 127.0.0.1) -- set this if the API will ever be
# reachable from outside localhost.
API_ACCESS_TOKEN=

# Comma-separated list of origins the API accepts CORS requests from.
# Defaults to the Vite dev server (both localhost variants). Add the
# frontend's origin here if it's served from somewhere else --
# e.g. the Docker Compose setup (see docker-compose.yml,
# docs/DEPLOYMENT.md), where the frontend is served by nginx on a
# different port.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =====================================================
# ALERTING
# =====================================================

# Generic webhook URL (receives a POST with a JSON body: level,
# message, context, timestamp) for CRITICAL events -- an unprotected
# live position, a startup reconciliation gap between the exchange
# and the local database, etc. Leave empty to disable; these events
# are always logged locally regardless.
WEBHOOK_ALERT_URL=

# =====================================================
# DATABASE
# =====================================================

DATABASE_URL=sqlite:///crypto_bot.db
